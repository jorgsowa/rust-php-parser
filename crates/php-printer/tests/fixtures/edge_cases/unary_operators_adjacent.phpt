===source===
<?php
$a = !!$b;
$a = ~~$b;
$a = -$b ** 2;
$a = (-$b) ** 2;
$a = -(-$b);
$a = -(-1);
$a = $b - -$c;
$a = $b + +$c;
$a = $b - --$c;
$a = $b + ++$c;
$a = $b-- - $c;
$a = $b++ + ++$c - $d-- - --$e;
$a = -PHP_INT_MAX - 1;
