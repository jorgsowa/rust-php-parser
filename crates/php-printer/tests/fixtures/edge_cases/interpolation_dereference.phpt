===source===
<?php
$a = "$b[0]c";
$a = "$b->c[0]";
$a = "{$b->c}d";
$a = "$b?->c";
$a = "{$b?->c}";
$a = "$b[c]";
$a = "$b[$c]";
$a = "{$b::$c}";
$a = "{$b()}";
$a = "{$a['k']}";
$a = "{$a["k$b"]}";
$a = "{$a(fn() => "x")}";
===print===
<?php
$a = "{$b[0]}c";
$a = "{$b->c}[0]";
$a = "{$b->c}d";
$a = "{$b}?->c";
$a = "{$b?->c}";
$a = "{$b['c']}";
$a = "{$b[$c]}";
$a = "{$b::$c}";
$a = "{$b()}";
$a = "{$a['k']}";
$a = "{$a["k$b"]}";
$a = "{$a(fn() => 'x')}";
